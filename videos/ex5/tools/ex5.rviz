Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 5
      Plane Cell Count: 14
      Reference Frame: <Fixed Frame>
      Color: 70; 82; 94
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /ouster/scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Flat Squares
      Size (m): 0.12
      Color Transformer: FlatColor
      Color: 82; 198; 222
      Alpha: 0.6
      Decay Time: 60
      Queue Size: 10
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Path
      Enabled: true
      Topic:
        Value: /icp_path
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 255; 139; 79
      Line Style: Billboards
      Line Width: 0.25
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 4
      Frame Timeout: 15
      Frames:
        All Enabled: false
        odom:
          Value: true
        base_footprint:
          Value: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 15; 21; 27
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools: []
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 1.5708
      Scale: 22
      X: 1
      Y: -13
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: true
  Height: 760
  Hide Left Dock: true
  Hide Right Dock: true
  Width: 1300
  X: 40
  Y: 40
